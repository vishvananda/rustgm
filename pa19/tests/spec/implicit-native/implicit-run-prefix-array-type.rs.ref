function @rg.20() -> void {
  slot $s0 : u8
  slot $s1 : obj<2x1>
  block ^b0:
    store u8 7, $s1
    %t0 = addr $s1
    %t1 = index u8 %t0, 1
    store u8 9, %t1
    %t2 = addr $s1
    %t3 = call u8 @rg.19.i3(%t2)
    store u8 %t3, $s0
    %t4 = load u8 $s0
    %t5 = cmp eq u8 %t4, 7
    %t6 = convert trunc i1 i64 %t5
    call void @rg.13(%t6)
    return void
}
function @rg.19.i3(%p0 : ptr) -> u8 {
  slot $s0 : obj<2x1>
  block ^b0:
    %t0 = addr $s0
    copyobj 2x1 %p0, %t0
    %t1 = cmp uge i64 0, 2
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary mul i64 0, 1
    %t3 = addr $s0
    %t4 = index u8 %t3, %t2
    %t5 = load u8 %t4
    return u8 %t5
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
