function @rg.21() -> void {
  slot $s0 : obj<2x1>
  slot $s1 : obj<2x1>
  block ^b0:
    store u8 2, $s0
    %t0 = addr $s0
    %t1 = index u8 %t0, 1
    store u8 7, %t1
    %t2 = addr $s1
    %t3 = addr $s0
    call void @rg.16.i3(%t2, %t3)
    %t4 = addr $s1
    %t5 = call u8 @rg.18.i4(%t4)
    %t6 = cmp eq u8 %t5, 7
    %t7 = convert trunc i1 i64 %t6
    call void @rg.13(%t7)
    return void
}
function @rg.16.i3(%p0 : ptr, %p1 : ptr) -> void {
  slot $s0 : obj<2x1>
  slot $s1 : obj<2x1>
  slot $s2 : obj<2x1>
  block ^b0:
    %t0 = addr $s0
    copyobj 2x1 %p1, %t0
    %t1 = addr $s0
    %t2 = addr $s1
    copyobj 2x1 %t1, %t2
    %t3 = addr $s1
    %t4 = addr $s2
    copyobj 2x1 %t3, %t4
    %t5 = addr $s2
    copyobj 2x1 %t5, %p0
    return void
}
function @rg.18.i4(%p0 : ptr) -> u8 {
  slot $s0 : obj<2x1>
  block ^b0:
    %t0 = addr $s0
    copyobj 2x1 %p0, %t0
    %t1 = binary sub i64 2, 1
    %t2 = cmp ult i64 2, 1
    branch %t2, ^b1, ^b2
  block ^b2:
    %t3 = cmp uge i64 %t1, 2
    branch %t3, ^b1, ^b3
  block ^b3:
    %t4 = binary mul i64 %t1, 1
    %t5 = addr $s0
    %t6 = index u8 %t5, %t4
    %t7 = load u8 %t6
    return u8 %t7
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.21()
    return i64 0
}
