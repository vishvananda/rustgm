  block ^b3:
    %t5 = load u32 $s1
    %t6 = load u32 $s2
    %t7 = binary add u32 %t6, %t5
    %t8 = cmp ult u32 %t7, %t6
    branch %t8, ^b4, ^b5
  block ^b5:
    store u32 %t7, $s2
    %t9 = load u32 $s1
    %t10 = binary add u32 %t9, 1
    %t11 = cmp ult u32 %t10, %t9
    branch %t11, ^b4, ^b6
  block ^b6:
    store u32 %t10, $s1
    jump ^b1
