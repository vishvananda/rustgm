    %t8 = binary xor i32 %t6, %t7
    %t9 = binary xor i32 %t7, 1
    %t10 = binary and i32 %t8, %t9
    %t11 = cmp lt i32 %t10, 0
    branch %t11, ^b4, ^b5
  block ^b5:
    store i32 %t7, $s0
    jump ^b1
  block ^b4:
    call void @abort()
