    %t2 = cmp uge i128 %t1, 8
    branch %t2, ^b1, ^b2
  block ^b2:
    %t3 = convert trunc u8 i128 %t1
    %t4 = binary shl u8 %t0, %t3
    return u8 %t4
  block ^b1:
    call void @abort()
    unreachable
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
