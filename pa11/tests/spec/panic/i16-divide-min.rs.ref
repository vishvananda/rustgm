function @rg.14() -> void {
  block ^b0:
    %t0 = unary neg i16 32768
    %t1 = unary neg i16 1
    %t2 = call i16 @rg.13(%t0, %t1)
    return void
}
function @rg.13(%p0 : i16, %p1 : i16) -> i16 {
  slot $s0 : i16
  slot $s1 : i16
  block ^b0:
    store i16 %p0, $s0
    store i16 %p1, $s1
    %t0 = load i16 $s0
    %t1 = load i16 $s1
    %t2 = cmp eq i16 %t1, 0
    branch %t2, ^b1, ^b2
  block ^b2:
    %t3 = cmp eq i16 %t0, 32768
    %t4 = cmp eq i16 %t1, 65535
    %t5 = binary and i64 %t3, %t4
    branch %t5, ^b1, ^b3
  block ^b3:
    %t6 = binary div i16 %t0, %t1
    return i16 %t6
  block ^b1:
    call void @abort()
    unreachable
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.14()
    return i64 0
}
