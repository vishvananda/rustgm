function @rg.15() -> void {
  block ^b0:
    %t0 = unary neg i16 1
    %t1 = call i16 @rg.14(1, %t0)
    return void
}
function @rg.14(%p0 : i16, %p1 : i16) -> i16 {
  slot $s0 : i16
  slot $s1 : i16
  block ^b0:
    store i16 %p0, $s0
    store i16 %p1, $s1
    %t0 = load i16 $s0
    %t1 = load i16 $s1
    %t2 = cmp uge i16 %t1, 16
    branch %t2, ^b1, ^b2
  block ^b2:
    %t3 = binary shr i16 %t0, %t1
    return i16 %t3
  block ^b1:
    call void @abort()
    unreachable
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.15()
    return i64 0
}
