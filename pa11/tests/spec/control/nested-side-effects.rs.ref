function @rg.16() -> void {
  block ^b0:
    %t0 = call i64 @rg.15()
    %t1 = cmp eq i64 %t0, 3
    %t2 = convert trunc i1 i64 %t1
    call void @rg.13(%t2)
    return void
}
function @rg.15() -> i64 {
  slot $s0 : i64
  slot $s1 : i1
  slot $s2 : i1
  block ^b0:
    store i64 0, $s0
    branch 1, ^b4, ^b5
  block ^b5:
    store i1 1, $s2
    jump ^b6
  block ^b4:
    %t0 = load i64 $s0
    %t1 = binary add i64 %t0, 1
    %t2 = cmp ult i64 %t1, %t0
    branch %t2, ^b7, ^b8
  block ^b8:
    store i64 %t1, $s0
    store i1 0, $s2
    jump ^b6
  block ^b6:
    %t3 = load i1 $s2
    branch %t3, ^b1, ^b2
  block ^b2:
    %t4 = load i64 $s0
    %t5 = binary add i64 %t4, 2
    %t6 = cmp ult i64 %t5, %t4
    branch %t6, ^b7, ^b9
  block ^b9:
    store i64 %t5, $s0
    store i1 1, $s1
    jump ^b3
  block ^b1:
    store i1 %t3, $s1
    jump ^b3
  block ^b3:
    %t7 = load i1 $s1
    %t8 = load i64 $s0
    return i64 %t8
  block ^b7:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call i32 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : i32) -> i32 {
  slot $s0 : i32
  block ^b0:
    store i32 %p0, $s0
    %t0 = load i32 $s0
    %t1 = cmp eq i32 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = cmp eq i32 1, 2147483648
    %t3 = cmp eq i32 %t0, 4294967295
    %t4 = binary and i64 %t2, %t3
    branch %t4, ^b1, ^b3
  block ^b3:
    %t5 = binary div i32 1, %t0
    return i32 %t5
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
