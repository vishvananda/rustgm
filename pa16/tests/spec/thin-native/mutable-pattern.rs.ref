function @rg.16() -> void {
  slot $s0 : obj<2x1>
  slot $s1 : i1
  slot $s2 : obj<2x1>
  slot $s3 : ptr
  block ^b0:
    store u8 3, $s2
    %t0 = addr $s2
    %t1 = index u8 %t0, 1
    store u8 4, %t1
    %t2 = addr $s2
    %t3 = addr $s0
    copyobj 2x1 %t2, %t3
    %t4 = addr $s0
    store ptr %t4, $s3
    %t5 = load ptr $s3
    call void @rg.15(%t5)
    %t6 = load u8 $s0
    %t7 = cmp eq u8 %t6, 7
    %t8 = convert trunc i1 i64 %t7
    branch %t8, ^b1, ^b2
  block ^b2:
    store i1 %t8, $s1
    jump ^b3
  block ^b1:
    %t9 = addr $s0
    %t10 = index u8 %t9, 1
    %t11 = load u8 %t10
    %t12 = cmp eq u8 %t11, 4
    %t13 = convert trunc i1 i64 %t12
    store i1 %t13, $s1
    jump ^b3
  block ^b3:
    %t14 = load i1 $s1
    call void @rg.13(%t14)
    return void
}
function @rg.15(%p0 : ptr) -> void {
  slot $s0 : ptr
  slot $s1 : ptr
  slot $s2 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    store ptr %t0, $s1
    %t1 = index u8 %t0, 1
    store ptr %t1, $s2
    %t2 = load ptr $s2
    %t3 = load u8 %t2
    %t4 = load ptr $s1
    %t5 = load u8 %t4
    %t6 = convert zext i16 u8 %t5
    %t7 = convert zext i16 u8 %t3
    %t8 = binary add i16 %t6, %t7
    %t9 = convert trunc u8 i16 %t8
    %t10 = convert zext i16 u8 %t9
    %t11 = cmp ne i16 %t8, %t10
    branch %t11, ^b1, ^b2
  block ^b2:
    store u8 %t9, %t4
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
