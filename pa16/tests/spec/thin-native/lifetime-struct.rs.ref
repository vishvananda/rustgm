function @rg.17() -> void {
  slot $s0 : u8
  slot $s1 : ptr
  slot $s2 : obj<8x8>
  block ^b0:
    store u8 41, $s0
    %t0 = addr $s0
    store ptr %t0, $s1
    %t1 = load ptr $s1
    store ptr %t1, $s2
    %t2 = addr $s2
    call void @rg.16(%t2)
    %t3 = load u8 $s0
    %t4 = cmp eq u8 %t3, 42
    %t5 = convert trunc i1 i64 %t4
    call void @rg.13(%t5)
    return void
}
function @rg.16(%p0 : ptr) -> void {
  slot $s0 : obj<8x8>
  block ^b0:
    %t0 = addr $s0
    copyobj 8x8 %p0, %t0
    %t1 = load ptr $s0
    %t2 = load u8 %t1
    %t3 = convert zext i16 u8 %t2
    %t4 = convert zext i16 u8 1
    %t5 = binary add i16 %t3, %t4
    %t6 = convert trunc u8 i16 %t5
    %t7 = convert zext i16 u8 %t6
    %t8 = cmp ne i16 %t5, %t7
    branch %t8, ^b1, ^b2
  block ^b2:
    store u8 %t6, %t1
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.17()
    return i64 0
}
