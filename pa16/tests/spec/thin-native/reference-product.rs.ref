    %t6 = addr $s5
    %t7 = addr $s2
    copyobj 16x8 %t6, %t7
    %t8 = load ptr $s2
    %t9 = load u8 %t8
    %t10 = cmp eq u8 %t9, 7
    %t11 = convert trunc i1 i64 %t10
    branch %t11, ^b1, ^b2
  block ^b2:
    store i1 %t11, $s3
    jump ^b3
  block ^b1:
    %t12 = addr $s2
    %t13 = index u8 %t12, 8
    %t14 = load ptr %t13
    %t15 = load u8 %t14
    %t16 = cmp eq u8 %t15, 9
    %t17 = convert trunc i1 i64 %t16
    store i1 %t17, $s3
    jump ^b3
  block ^b3:
    %t18 = load i1 $s3
    call void @rg.13(%t18)
