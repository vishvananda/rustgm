}
function @rg.15(%p0 : ptr, %p1 : ptr) -> void {
  slot $s0 : obj<16x8>
  slot $s1 : obj<16x8>
  block ^b0:
    %t0 = addr $s0
    copyobj 16x8 %p1, %t0
    %t1 = addr $s0
