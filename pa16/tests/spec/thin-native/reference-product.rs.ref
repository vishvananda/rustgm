function @rg.16() -> void {
  slot $s0 : u8
  slot $s1 : u8
  slot $s2 : obj<16x8>
  slot $s3 : i1
  slot $s4 : obj<16x8>
  slot $s5 : obj<16x8>
  block ^b0:
    store u8 7, $s0
