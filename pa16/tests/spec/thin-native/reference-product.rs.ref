    %t3 = addr $s1
    copyobj 16x8 %t3, %p0
    return void
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
