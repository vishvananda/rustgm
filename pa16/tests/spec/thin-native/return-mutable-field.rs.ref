}
function @rg.15(%p0 : ptr, %p1 : ptr) -> ptr {
  slot $s0 : ptr
  slot $s1 : ptr
  slot $s2 : ptr
  slot $s3 : ptr
  block ^b0:
    store ptr %p0, $s0
