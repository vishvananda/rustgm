    %t10 = load i64 %t9
    %t11 = load ptr $s3
    %t12 = load i64 %t11
    %t13 = binary add i64 %t12, %t10
    %t14 = cmp ult i64 %t13, %t12
    branch %t14, ^b1, ^b3
  block ^b3:
