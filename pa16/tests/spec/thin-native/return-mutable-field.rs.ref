    %t14 = load i64 $s3
    %t15 = addr $s0
    %t16 = index u8 %t15, 8
    %t17 = load i64 %t16
    %t18 = binary add i64 %t14, %t17
    %t19 = cmp ult i64 %t18, %t14
    branch %t19, ^b1, ^b2
  block ^b2:
    %t20 = cmp eq i64 %t18, 10
    %t21 = convert trunc i1 i64 %t20
    call void @rg.13(%t21)
    return void
  block ^b1:
    call void @abort()
