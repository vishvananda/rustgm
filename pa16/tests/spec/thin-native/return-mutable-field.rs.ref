    store ptr %t8, $s6
    %t9 = load ptr $s6
    %t10 = addr $s1
    %t11 = call ptr @rg.15(%t9, %t10)
    store ptr %t11, $s2
    %t12 = load ptr $s2
    %t13 = load i64 %t12
