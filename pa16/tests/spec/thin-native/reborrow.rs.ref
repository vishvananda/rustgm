function @rg.16() -> void {
  slot $s0 : i64
  slot $s1 : ptr
  block ^b0:
    store i64 40, $s0
    %t0 = addr $s0
    store ptr %t0, $s1
    %t1 = load ptr $s1
    call void @rg.15(%t1)
    %t2 = load ptr $s1
    call void @rg.15(%t2)
    %t3 = load ptr $s1
    %t4 = load i64 %t3
    %t5 = cmp eq i64 %t4, 42
    %t6 = convert trunc i1 i64 %t5
    call void @rg.13(%t6)
    return void
}
function @rg.15(%p0 : ptr) -> void {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    %t1 = load i64 %t0
    %t2 = convert zext i128 i64 %t1
    %t3 = convert zext i128 i64 1
    %t4 = binary add i128 %t2, %t3
    %t5 = convert trunc i64 i128 %t4
    %t6 = convert zext i128 i64 %t5
    %t7 = cmp ne i128 %t4, %t6
    branch %t7, ^b1, ^b2
  block ^b2:
    store i64 %t5, %t0
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
