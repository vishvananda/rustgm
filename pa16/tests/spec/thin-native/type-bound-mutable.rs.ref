function @rg.16() -> void {
  slot $s0 : u16
  slot $s1 : ptr
  slot $s2 : ptr
  block ^b0:
    store u16 11, $s0
    %t0 = addr $s0
    store ptr %t0, $s2
    %t1 = load ptr $s2
    %t2 = call ptr @rg.15(%t1)
    store ptr %t2, $s1
    %t3 = load ptr $s1
    %t4 = load u16 %t3
    %t5 = convert zext i32 u16 %t4
    %t6 = convert zext i32 u16 7
    %t7 = binary add i32 %t5, %t6
    %t8 = convert trunc u16 i32 %t7
    %t9 = convert zext i32 u16 %t8
    %t10 = cmp ne i32 %t7, %t9
    branch %t10, ^b1, ^b2
  block ^b2:
    store u16 %t8, %t3
    %t11 = load ptr $s1
    %t12 = load u16 %t11
    %t13 = cmp eq u16 %t12, 18
    %t14 = convert trunc i1 i64 %t13
    call void @rg.13(%t14)
    %t15 = load u16 $s0
    %t16 = cmp eq u16 %t15, 18
    %t17 = convert trunc i1 i64 %t16
    call void @rg.13(%t17)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.15(%p0 : ptr) -> ptr {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    return ptr %t0
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
