global @rg.data.0 : obj<1x1> [storage=readonly] = {
  zero 1
}
function @rg.16() -> void {
  block ^b0:
    %t0 = call ptr @rg.15()
    return void
}
function @rg.15() -> ptr {
  slot $s0 : ptr
  block ^b0:
    %t0 = binary add u8 255, 1
    %t1 = cmp ult u8 %t0, 255
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = addr @rg.data.0
    store ptr %t2, $s0
    %t3 = load ptr $s0
    return ptr %t3
  block ^b1:
    call void @abort()
    unreachable
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
