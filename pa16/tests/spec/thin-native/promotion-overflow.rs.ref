    %t0 = convert zext i16 u8 255
    %t1 = convert zext i16 u8 1
    %t2 = binary add i16 %t0, %t1
    %t3 = convert trunc u8 i16 %t2
    %t4 = convert zext i16 u8 %t3
    %t5 = cmp ne i16 %t2, %t4
    branch %t5, ^b1, ^b2
  block ^b2:
    %t6 = addr @rg.data.0
    return ptr %t6
  block ^b1:
    call void @abort()
    unreachable
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
