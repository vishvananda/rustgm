  block ^b5:
    %t8 = binary mul i64 0, 2
    %t9 = index u8 %t6, %t8
    %t10 = load u16 %t9
    %t11 = cmp eq u16 %t10, 7
    %t12 = convert trunc i1 i64 %t11
    store i1 %t12, $s0
