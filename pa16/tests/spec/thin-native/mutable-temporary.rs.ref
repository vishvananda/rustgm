function @rg.15() -> void {
  slot $s0 : ptr
  slot $s1 : i64
  block ^b0:
    store i64 40, $s1
    %t0 = addr $s1
    store ptr %t0, $s0
    %t1 = load ptr $s0
    %t2 = load i64 %t1
    %t3 = binary add i64 %t2, 2
    %t4 = cmp ult i64 %t3, %t2
    branch %t4, ^b1, ^b2
  block ^b2:
    store i64 %t3, %t1
    %t5 = load ptr $s0
    %t6 = load i64 %t5
    %t7 = cmp eq i64 %t6, 42
    %t8 = convert trunc i1 i64 %t7
    call void @rg.13(%t8)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.15()
    return i64 0
}
