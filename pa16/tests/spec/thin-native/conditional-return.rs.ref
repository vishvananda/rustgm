function @rg.16() -> void {
  slot $s0 : i64
  slot $s1 : i64
  slot $s2 : i1
  slot $s3 : ptr
  slot $s4 : ptr
  block ^b0:
    store i64 7, $s0
    store i64 9, $s1
    %t0 = addr $s0
    %t1 = addr $s1
    %t2 = call ptr @rg.15(%t0, %t1, 1)
    store ptr %t2, $s3
    %t3 = load ptr $s3
    %t4 = load i64 %t3
    %t5 = cmp eq i64 %t4, 7
    %t6 = convert trunc i1 i64 %t5
    branch %t6, ^b1, ^b2
  block ^b2:
    store i1 %t6, $s2
    jump ^b3
  block ^b1:
    %t7 = addr $s0
    %t8 = addr $s1
    %t9 = call ptr @rg.15(%t7, %t8, 0)
    store ptr %t9, $s4
    %t10 = load ptr $s4
    %t11 = load i64 %t10
    %t12 = cmp eq i64 %t11, 9
    %t13 = convert trunc i1 i64 %t12
    store i1 %t13, $s2
    jump ^b3
  block ^b3:
    %t14 = load i1 $s2
    call void @rg.13(%t14)
    return void
}
function @rg.15(%p0 : ptr, %p1 : ptr, %p2 : i1) -> ptr {
  slot $s0 : ptr
  slot $s1 : ptr
  slot $s2 : i1
  slot $s3 : ptr
  block ^b0:
    store ptr %p0, $s0
    store ptr %p1, $s1
    store i1 %p2, $s2
    %t0 = load i1 $s2
    branch %t0, ^b1, ^b2
  block ^b2:
    %t1 = load ptr $s1
    store ptr %t1, $s3
    jump ^b3
  block ^b1:
    %t2 = load ptr $s0
    store ptr %t2, $s3
    jump ^b3
  block ^b3:
    %t3 = load ptr $s3
    return ptr %t3
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
