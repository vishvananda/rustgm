function @rg.16() -> void {
  slot $s0 : i64
  slot $s1 : i64
  slot $s2 : ptr
  block ^b0:
    store i64 40, $s0
    store i64 2, $s1
    %t0 = addr $s0
    store ptr %t0, $s2
    %t1 = load ptr $s2
    %t2 = addr $s1
    call void @rg.15(%t1, %t2)
    %t3 = load i64 $s0
    %t4 = cmp eq i64 %t3, 42
    %t5 = convert trunc i1 i64 %t4
    call void @rg.13(%t5)
    return void
}
function @rg.15(%p0 : ptr, %p1 : ptr) -> void {
  slot $s0 : ptr
  slot $s1 : ptr
  block ^b0:
    store ptr %p0, $s0
    store ptr %p1, $s1
    %t0 = load ptr $s1
    %t1 = load i64 %t0
    %t2 = load ptr $s0
    %t3 = load i64 %t2
    %t4 = convert zext i128 i64 %t3
    %t5 = convert zext i128 i64 %t1
    %t6 = binary add i128 %t4, %t5
    %t7 = convert trunc i64 i128 %t6
    %t8 = convert zext i128 i64 %t7
    %t9 = cmp ne i128 %t6, %t8
    branch %t9, ^b1, ^b2
  block ^b2:
    store i64 %t7, %t2
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
