function @rg.14() -> void {
  slot $s0 : ptr
  slot $s1 : u8
  slot $s2 : ptr
  block ^b0:
    store u8 7, $s1
    %t0 = addr $s1
    store ptr %t0, $s2
    %t1 = load ptr $s2
    %t2 = call ptr @rg.13(%t1)
    store ptr %t2, $s0
    return void
}
function @rg.13(%p0 : ptr) -> ptr {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    return ptr %t0
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.14()
    return i64 0
}
