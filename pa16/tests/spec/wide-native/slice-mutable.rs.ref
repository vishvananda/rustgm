    %t0 = addr $s1
    %t1 = index u8 %t0, 1
    store u8 41, %t1
    %t2 = addr $s1
    %t3 = index u8 %t2, 2
    store u8 3, %t3
    %t4 = addr $s1
    %t5 = addr $s0
    copyobj 3x1 %t4, %t5
