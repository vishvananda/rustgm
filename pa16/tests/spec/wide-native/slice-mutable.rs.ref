  block ^b2:
    %t12 = binary mul i64 1, 1
    %t13 = addr $s0
    %t14 = index u8 %t13, %t12
    %t15 = load u8 %t14
    %t16 = cmp eq u8 %t15, 42
    %t17 = convert trunc i1 i64 %t16
    call void @rg.13(%t17)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.15(%p0 : ptr) -> void {
  slot $s0 : obj<16x8>
