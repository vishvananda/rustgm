  block ^b2:
    %t6 = binary mul i64 1, 1
    %t7 = index u8 %t1, %t6
    %t8 = load u8 %t7
    %t9 = binary add u8 %t8, 1
    %t10 = cmp ult u8 %t9, %t8
    branch %t10, ^b1, ^b3
  block ^b3:
    store u8 %t9, %t7
    return void
  block ^b1:
    call void @abort()
    unreachable
