function @rg.16() -> void {
  slot $s0 : obj<2x1>
  slot $s1 : obj<2x1>
  slot $s2 : obj<16x8>
  slot $s3 : ptr
  block ^b0:
    store u8 7, $s1
    %t0 = addr $s1
    %t1 = index u8 %t0, 1
    store u8 9, %t1
    %t2 = addr $s1
    %t3 = addr $s0
    copyobj 2x1 %t2, %t3
    %t4 = addr $s0
    store ptr %t4, $s2
    %t5 = addr $s2
    %t6 = index u8 %t5, 8
    store i64 2, %t6
    %t7 = addr $s2
    %t8 = call ptr @rg.15(%t7)
    store ptr %t8, $s3
    %t9 = load ptr $s3
    %t10 = load u8 %t9
    %t11 = cmp eq u8 %t10, 9
    %t12 = convert trunc i1 i64 %t11
    call void @rg.13(%t12)
    return void
}
function @rg.15(%p0 : ptr) -> ptr {
  slot $s0 : obj<16x8>
  block ^b0:
    %t0 = addr $s0
    copyobj 16x8 %p0, %t0
    %t1 = load ptr $s0
    %t2 = addr $s0
    %t3 = index u8 %t2, 8
    %t4 = load i64 %t3
    %t5 = cmp uge i64 1, %t4
    branch %t5, ^b1, ^b2
  block ^b2:
    %t6 = binary mul i64 1, 1
    %t7 = index u8 %t1, %t6
    return ptr %t7
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
