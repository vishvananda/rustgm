    %t13 = load ptr $s1
    %t14 = addr $s1
    %t15 = index u8 %t14, 8
    %t16 = load i64 %t15
    %t17 = cmp uge i64 2, %t16
    branch %t17, ^b1, ^b2
  block ^b2:
    %t18 = binary mul i64 2, 1
    %t19 = index u8 %t13, %t18
    %t20 = load u8 %t19
    %t21 = cmp eq u8 %t20, 9
    %t22 = convert trunc i1 i64 %t21
    call void @rg.13(%t22)
