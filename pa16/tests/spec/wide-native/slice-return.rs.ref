}
function @rg.15(%p0 : ptr, %p1 : ptr) -> void {
  slot $s0 : obj<16x8>
  slot $s1 : obj<16x8>
  block ^b0:
    %t0 = addr $s0
    copyobj 16x8 %p1, %t0
    %t1 = addr $s0
    %t2 = addr $s1
    copyobj 16x8 %t1, %t2
    %t3 = addr $s1
    copyobj 16x8 %t3, %p0
    return void
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
