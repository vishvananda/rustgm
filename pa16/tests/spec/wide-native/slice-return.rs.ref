    %t1 = index u8 %t0, 1
    store u8 7, %t1
    %t2 = addr $s2
    %t3 = index u8 %t2, 2
    store u8 9, %t3
    %t4 = addr $s2
    %t5 = addr $s0
    copyobj 3x1 %t4, %t5
    %t6 = addr $s0
