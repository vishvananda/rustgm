    %t12 = addr $s5
    %t13 = addr $s1
    copyobj 16x8 %t12, %t13
    %t14 = load ptr $s1
    %t15 = addr $s1
    %t16 = index u8 %t15, 8
    %t17 = load i64 %t16
    %t18 = cmp uge i64 2, %t17
    branch %t18, ^b1, ^b2
  block ^b2:
    %t19 = binary mul i64 2, 1
    %t20 = index u8 %t14, %t19
    %t21 = load u8 %t20
    %t22 = cmp eq u8 %t21, 9
    %t23 = convert trunc i1 i64 %t22
    call void @rg.13(%t23)
    return void
  block ^b1:
    call void @abort()
