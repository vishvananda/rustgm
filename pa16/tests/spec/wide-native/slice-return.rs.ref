function @rg.16() -> void {
  slot $s0 : obj<3x1>
  slot $s1 : obj<16x8>
  slot $s2 : obj<3x1>
  slot $s3 : ptr
  slot $s4 : obj<16x8>
  slot $s5 : obj<16x8>
