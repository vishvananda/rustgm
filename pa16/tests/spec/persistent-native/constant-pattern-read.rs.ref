function @rg.16() -> void {
  block ^b0:
    %t0 = cmp eq u8 7, 7
    %t1 = convert trunc i1 i64 %t0
    branch %t1, ^b2, ^b3
  block ^b3:
    jump ^b4
  block ^b4:
    jump ^b1
  block ^b2:
    jump ^b1
  block ^b1:
    return void
  block ^b5:
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
