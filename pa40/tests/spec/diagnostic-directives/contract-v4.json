  "scope": "Recognize diagnostic-only requests; preserve hard literal/unsafe/const/trait/macro errors under authenticated Allow cap. Custom error text and strict diagnostics remain required, not inferred from suppression.",
  "strict_boundary": {
    "required_status": 0,
    "current_status": 1,
    "message": "uncapped const/macro diagnostic directive profile is not implemented",
    "cases": [
      "const-valid",
      "macro-valid"
    ]
  },
  "native": {
    "case": "native",
    "observer": "pa40/tests/spec/diagnostic-directives/observer.c",
    "observer_sha256": "73886fda3aab66dd1a71d0845b7e9561f4b7b24929631b1ce7aa256a3420d13e",
    "stdout": "7 9\n",
    "control": "native-control"
  },
  "corrections": "v1 independent oracle disproved suffix hard errors and exposed invalid disabled fixture ownership; v1 evidence is retained.",
  "strict_inactive": {
    "required_status": 0,
    "current_status": 0,
    "cases": [
      "const-missing-feature",
      "macro-missing-feature"
    ],
    "scope": "The pinned handlers ignore metadata without the actual crate feature; optional unknown-diagnostic warnings remain separate."
  }
}
