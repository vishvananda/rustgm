function @rg.15() -> void {
  slot $s0 : u8
  slot $s1 : u8
  slot $s2 : ptr
  block ^b0:
    %t0 = call u8 @rg.13()
    store u8 %t0, $s1
    %t1 = addr $s1
    store ptr %t1, $s2
    %t2 = load ptr $s2
    %t3 = call u8 @rg.14(%t2)
    store u8 %t3, $s0
    %t4 = load u8 $s0
    %t5 = cmp eq u8 %t4, 7
    %t6 = convert trunc i1 i64 %t5
    %t7 = copy u8 %t6
    %t8 = cmp eq u8 %t7, 0
    branch %t8, ^b1, ^b2
  block ^b2:
    %t9 = binary udiv u8 1, %t7
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13() -> u8 {
  block ^b0:
    return u8 7
}
function @rg.14(%p0 : ptr) -> u8 {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    %t1 = load u8 %t0
    return u8 %t1
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.15()
    return i64 0
}
