function @rg.14() -> void {
  block ^b0:
    %t0 = call u8 @edition_value()
    %t1 = cmp eq u8 %t0, 7
    %t2 = convert trunc i1 i64 %t1
    %t3 = copy u8 %t2
    %t4 = cmp eq u8 %t3, 0
    branch %t4, ^b1, ^b2
  block ^b2:
    %t5 = binary udiv u8 1, %t3
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @edition_value() -> u8 {
  block ^b0:
    return u8 7
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.14()
    return i64 0
}
