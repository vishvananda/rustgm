function @rg.16() -> void {
  block ^b0:
    %t0 = call u8 @rg.15()
    %t1 = cmp eq u8 %t0, 7
    %t2 = convert trunc i1 i64 %t1
    call void @rg.13(%t2)
    return void
}
function @rg.15() -> u8 {
  slot $s0 : i32
  slot $s1 : u8
  block ^b0:
    store i32 2, $s0
    jump ^b1
  block ^b1:
    %t0 = load i32 $s0
    %t1 = cmp eq i32 %t0, 0
    %t2 = convert trunc i1 i64 %t1
    branch %t2, ^b4, ^b5
  block ^b5:
    jump ^b6
  block ^b6:
    %t3 = load i32 $s0
    %t4 = convert sext i64 i32 %t3
    %t5 = convert sext i64 i32 1
    %t6 = binary sub i64 %t4, %t5
    %t7 = convert trunc i32 i64 %t6
    %t8 = convert sext i64 i32 %t7
    %t9 = cmp ne i64 %t6, %t8
    branch %t9, ^b8, ^b9
  block ^b9:
    store i32 %t7, $s0
    jump ^b1
  block ^b4:
    store u8 7, $s1
    jump ^b2
  block ^b2:
    %t10 = load u8 $s1
    return u8 %t10
  block ^b3:
    unreachable
  block ^b7:
    unreachable
  block ^b8:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call i32 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : i32) -> i32 {
  slot $s0 : i32
  block ^b0:
    store i32 %p0, $s0
    %t0 = load i32 $s0
    %t1 = cmp eq i32 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = cmp eq i32 1, 2147483648
    %t3 = cmp eq i32 %t0, 4294967295
    %t4 = binary and i64 %t2, %t3
    branch %t4, ^b1, ^b3
  block ^b3:
    %t5 = binary div i32 1, %t0
    return i32 %t5
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
