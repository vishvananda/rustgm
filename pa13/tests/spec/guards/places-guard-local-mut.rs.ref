function @rg.16() -> void {
  block ^b0:
    %t0 = call i64 @rg.15()
    %t1 = cmp eq i64 %t0, 8
    %t2 = convert trunc i1 i64 %t1
    call void @rg.13(%t2)
    return void
}
function @rg.15() -> i64 {
  slot $s0 : i64
  slot $s1 : u8
  block ^b0:
    jump ^b4
  block ^b4:
    jump ^b2
  block ^b2:
    jump ^b10
  block ^b10:
    store u8 7, $s1
    jump ^b9
  block ^b9:
    %t0 = load u8 $s1
    %t1 = binary add u8 %t0, 1
    %t2 = cmp ult u8 %t1, %t0
    branch %t2, ^b15, ^b16
  block ^b16:
    store u8 %t1, $s1
    branch 1, ^b7, ^b12
  block ^b12:
    jump ^b8
  block ^b8:
    jump ^b5
  block ^b5:
    jump ^b3
  block ^b3:
    jump ^b6
  block ^b6:
    jump ^b13
  block ^b13:
    store i64 99, $s0
    jump ^b1
  block ^b7:
    %t3 = load u8 $s1
    %t4 = convert zext i64 u8 %t3
    store i64 %t4, $s0
    jump ^b1
  block ^b1:
    %t5 = load i64 $s0
    return i64 %t5
  block ^b11:
    unreachable
  block ^b14:
    unreachable
  block ^b15:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call i32 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : i32) -> i32 {
  slot $s0 : i32
  block ^b0:
    store i32 %p0, $s0
    %t0 = load i32 $s0
    %t1 = cmp eq i32 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = cmp eq i32 1, 2147483648
    %t3 = cmp eq i32 %t0, 4294967295
    %t4 = binary and i64 %t2, %t3
    branch %t4, ^b1, ^b3
  block ^b3:
    %t5 = binary div i32 1, %t0
    return i32 %t5
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
