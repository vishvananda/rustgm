    %t11 = convert trunc u8 i16 %t10
    %t12 = convert zext i16 u8 %t11
    %t13 = cmp ne i16 %t10, %t12
    branch %t13, ^b5, ^b6
  block ^b6:
    return u8 %t11
  block ^b5:
