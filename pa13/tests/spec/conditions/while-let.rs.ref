function @rg.16() -> void {
  block ^b0:
    %t0 = call u8 @rg.15()
    %t1 = cmp eq u8 %t0, 6
    %t2 = convert trunc i1 i64 %t1
    call void @rg.13(%t2)
    return void
}
function @rg.15() -> u8 {
  slot $s0 : u8
  slot $s1 : u8
  slot $s2 : u8
  block ^b0:
    store u8 3, $s0
    store u8 0, $s1
    jump ^b1
  block ^b1:
    %t0 = load u8 $s0
    %t1 = cmp uge u8 %t0, 1
    %t2 = convert trunc i1 i64 %t1
    %t3 = cmp ule u8 %t0, 3
    %t4 = convert trunc i1 i64 %t3
    %t5 = binary and i1 %t2, %t4
    branch %t5, ^b4, ^b5
  block ^b5:
    jump ^b3
  block ^b3:
    %t6 = load u8 $s1
    return u8 %t6
  block ^b4:
    %t7 = load u8 $s0
    store u8 %t7, $s2
    jump ^b2
  block ^b2:
    %t8 = load u8 $s2
    %t9 = load u8 $s1
    %t10 = binary add u8 %t9, %t8
    %t11 = cmp ult u8 %t10, %t9
    branch %t11, ^b6, ^b7
  block ^b7:
    store u8 %t10, $s1
    %t12 = load u8 $s0
    %t13 = binary sub u8 %t12, 1
    %t14 = cmp ult u8 %t12, 1
    branch %t14, ^b6, ^b8
  block ^b8:
    store u8 %t13, $s0
    jump ^b1
  block ^b6:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call i32 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : i32) -> i32 {
  slot $s0 : i32
  block ^b0:
    store i32 %p0, $s0
    %t0 = load i32 $s0
    %t1 = cmp eq i32 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = cmp eq i32 1, 2147483648
    %t3 = cmp eq i32 %t0, 4294967295
    %t4 = binary and i64 %t2, %t3
    branch %t4, ^b1, ^b3
  block ^b3:
    %t5 = binary div i32 1, %t0
    return i32 %t5
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
