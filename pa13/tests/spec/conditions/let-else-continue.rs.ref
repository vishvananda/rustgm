    %t7 = cmp eq i32 %t6, 0
    %t8 = convert trunc i1 i64 %t7
    branch %t8, ^b3, ^b4
  block ^b4:
    jump ^b5
  block ^b5:
    jump ^b1
  block ^b3:
    jump ^b6
  block ^b6:
    store u8 7, $s1
    jump ^b2
  block ^b2:
    %t9 = load u8 $s1
    return u8 %t9
  block ^b7:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call i32 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : i32) -> i32 {
  slot $s0 : i32
  block ^b0:
    store i32 %p0, $s0
    %t0 = load i32 $s0
    %t1 = cmp eq i32 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = cmp eq i32 1, 2147483648
    %t3 = cmp eq i32 %t0, 4294967295
    %t4 = binary and i64 %t2, %t3
    branch %t4, ^b1, ^b3
  block ^b3:
    %t5 = binary div i32 1, %t0
    return i32 %t5
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
