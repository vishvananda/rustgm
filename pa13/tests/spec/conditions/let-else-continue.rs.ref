function @rg.16() -> void {
  block ^b0:
    %t0 = call u8 @rg.15()
    %t1 = cmp eq u8 %t0, 7
    %t2 = convert trunc i1 i64 %t1
    call void @rg.13(%t2)
    return void
}
function @rg.15() -> u8 {
  slot $s0 : i32
  slot $s1 : u8
  block ^b0:
    store i32 4, $s0
    jump ^b1
  block ^b1:
    %t0 = load i32 $s0
    %t1 = binary sub i32 %t0, 1
    %t2 = binary xor i32 %t0, %t1
    %t3 = binary xor i32 %t0, 1
    %t4 = binary and i32 %t2, %t3
    %t5 = cmp lt i32 %t4, 0
    branch %t5, ^b7, ^b8
  block ^b8:
    store i32 %t1, $s0
