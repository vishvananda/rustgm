    %t1 = index u8 %t0, 2
    store u16 9, %t1
    %t2 = addr $s1
    %t3 = addr $s2
    copyobj 4x2 %t2, %t3
    %t4 = addr $s2
    %t5 = addr $s0
    copyobj 4x2 %t4, %t5
    %t6 = cmp uge i64 0, 2
