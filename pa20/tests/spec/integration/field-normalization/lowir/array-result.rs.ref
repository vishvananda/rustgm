  block ^b2:
    %t7 = binary mul i64 0, 2
    %t8 = addr $s0
    %t9 = index u8 %t8, %t7
    %t10 = load u16 %t9
    %t11 = cmp eq u16 %t10, 7
    %t12 = convert trunc i1 i64 %t11
    call void @rg.13(%t12)
    %t13 = cmp uge i64 1, 2
    branch %t13, ^b1, ^b3
  block ^b3:
    %t14 = binary mul i64 1, 2
    %t15 = addr $s0
    %t16 = index u8 %t15, %t14
    %t17 = load u16 %t16
    %t18 = cmp eq u16 %t17, 9
    %t19 = convert trunc i1 i64 %t18
    call void @rg.13(%t19)
    return void
  block ^b1:
    call void @abort()
