function @rg.16() -> void {
  slot $s0 : obj<1x1>
  slot $s1 : ptr
  slot $s2 : ptr
  slot $s3 : obj<1x1>
  slot $s4 : ptr
  slot $s5 : ptr
  block ^b0:
    store u8 7, $s3
    %t0 = addr $s3
    %t1 = addr $s0
    copyobj 1x1 %t0, %t1
    %t2 = addr $s0
    store ptr %t2, $s1
    %t3 = addr $s1
    store ptr %t3, $s2
    %t4 = addr $s2
    store ptr %t4, $s4
    %t5 = load ptr $s4
    %t6 = call ptr @rg.15.i3(%t5)
    store ptr %t6, $s5
    %t7 = load ptr $s5
    %t8 = load ptr %t7
    %t9 = cmp uge i64 0, 1
    branch %t9, ^b1, ^b2
  block ^b2:
    %t10 = binary mul i64 0, 1
    %t11 = index u8 %t8, %t10
    %t12 = load u8 %t11
    %t13 = cmp eq u8 %t12, 7
    %t14 = convert trunc i1 i64 %t13
    call void @rg.13(%t14)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.15.i3(%p0 : ptr) -> ptr {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    %t1 = load ptr %t0
    return ptr %t1
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
