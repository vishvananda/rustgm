function @rg.19() -> void {
  slot $s0 : obj<8x4>
  slot $s1 : obj<8x4>
  block ^b0:
    store i32 0, $s1
    %t0 = addr $s1
    %t1 = index u8 %t0, 4
    store i1 1, %t1
    %t2 = addr $s1
    %t3 = addr $s0
    copyobj 8x4 %t2, %t3
    return void
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.19()
    return i64 0
}
