function @rg.19() -> void {
  slot $s0 : obj<2x1>
  slot $s1 : obj<2x1>
  block ^b0:
    store u8 0, $s1
    %t0 = addr $s1
    %t1 = index u8 %t0, 1
    store u8 7, %t1
    %t2 = addr $s1
    %t3 = addr $s0
    copyobj 2x1 %t2, %t3
    return void
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.19()
    return i64 0
}
