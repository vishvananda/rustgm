    store u16 7, $s1
    %t1 = load ptr $s0
    %t2 = addr $s1
    store ptr %t2, $s2
    %t3 = load ptr $s2
    %t4 = call ptr %t1(%t3) as (%p0 : ptr) -> ptr
    store ptr %t4, $s3
    %t5 = load ptr $s3
    %t6 = load u16 %t5
    %t7 = cmp eq u16 %t6, 7
    %t8 = convert trunc i1 i64 %t7
    call void @rg.13(%t8)
    return void
