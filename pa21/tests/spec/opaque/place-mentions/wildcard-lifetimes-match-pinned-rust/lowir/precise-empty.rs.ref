function @rg.14() -> void {
  slot $s0 : u8
  slot $s1 : ptr
  block ^b0:
    store u8 7, $s0
    %t0 = addr $s0
    store ptr %t0, $s1
    %t1 = load ptr $s1
    call void @rg.13.i1(%t1)
    return void
}
function @rg.13.i1(%p0 : ptr) -> void {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    return void
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.14()
    return i64 0
}
