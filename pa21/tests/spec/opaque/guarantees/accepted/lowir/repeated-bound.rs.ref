function @rg.15() -> void {
  slot $s0 : u8
  slot $s1 : ptr
  slot $s2 : u8
  block ^b0:
    store u8 1, $s0
    store u8 2, $s2
    %t0 = addr $s0
    %t1 = addr $s2
    %t2 = call ptr @rg.13.i1(%t0, %t1)
    store ptr %t2, $s1
    %t3 = load ptr $s1
    call void @rg.14.i2(%t3)
    return void
}
function @rg.13.i1(%p0 : ptr, %p1 : ptr) -> ptr {
  slot $s0 : ptr
  slot $s1 : ptr
  block ^b0:
    store ptr %p0, $s0
    store ptr %p1, $s1
    %t0 = load ptr $s0
    return ptr %t0
}
function @rg.14.i2(%p0 : ptr) -> void {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    return void
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.15()
    return i64 0
}
