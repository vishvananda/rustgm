    %t3 = load u8 $s0
    call void @rg.14.i2(%t3)
    return void
}
function @rg.13.i1(%p0 : u8, %p1 : ptr) -> u8 {
  slot $s0 : u8
  slot $s1 : ptr
  block ^b0:
    store u8 %p0, $s0
