function @rg.14() -> void {
  slot $s0 : u8
  block ^b0:
    store u8 7, $s0
    %t0 = addr $s0
    %t1 = call u8 @rg.13.i1(%t0)
    return void
}
function @rg.13.i1(%p0 : ptr) -> u8 {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    return u8 7
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.14()
    return i64 0
}
