function @rg.20() -> void {
  slot $s0 : obj<3x1>
  slot $s1 : obj<3x1>
  block ^b0:
    %t0 = addr $s1
    call void @rg.19.i3(%t0)
    %t1 = addr $s1
    %t2 = addr $s0
    copyobj 3x1 %t1, %t2
    %t3 = cmp uge i64 2, 3
    branch %t3, ^b1, ^b2
  block ^b2:
    %t4 = binary mul i64 2, 1
    %t5 = addr $s0
    %t6 = index u8 %t5, %t4
    %t7 = load u8 %t6
    %t8 = cmp eq u8 %t7, 97
    %t9 = convert trunc i1 i64 %t8
    call void @rg.13(%t9)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.19.i3(%p0 : ptr) -> void {
  slot $s0 : obj<3x1>
  slot $s1 : i64
  block ^b0:
    store i64 0, $s1
    jump ^b1
  block ^b1:
    %t0 = load i64 $s1
    %t1 = cmp ult i64 %t0, 3
    branch %t1, ^b2, ^b3
  block ^b2:
    %t2 = binary mul i64 %t0, 1
    %t3 = addr $s0
    %t4 = index u8 %t3, %t2
    store u8 97, %t4
    %t5 = binary add i64 %t0, 1
    store i64 %t5, $s1
    jump ^b1
  block ^b3:
    %t6 = addr $s0
    copyobj 3x1 %t6, %p0
    return void
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
