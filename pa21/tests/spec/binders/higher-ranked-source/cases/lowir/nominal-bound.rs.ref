function @rg.17() -> void {
  slot $s0 : obj<1x1>
  slot $s1 : obj<1x1>
  block ^b0:
    store u8 7, $s1
    %t0 = addr $s1
    %t1 = addr $s0
    copyobj 1x1 %t0, %t1
    %t2 = load u8 $s0
    %t3 = cmp ne u8 %t2, 7
    %t4 = convert trunc i1 i64 %t3
    branch %t4, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b3:
    return void
  block ^b1:
    jump ^b4
  block ^b4:
    jump ^b4
  block ^b5:
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.17()
    return i64 0
}
