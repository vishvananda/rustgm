function @rg.20() -> void {
  slot $s0 : u8
  slot $s1 : ptr
  slot $s2 : ptr
  block ^b0:
    store u8 7, $s0
    %t0 = addr @rg.19
    %t1 = call ptr @rg.18.i2(%t0)
    store ptr %t1, $s1
    %t2 = load ptr $s1
    %t3 = addr $s0
    %t4 = call ptr %t2(%t3) as (%p0 : ptr) -> ptr
    store ptr %t4, $s2
    %t5 = load ptr $s2
    %t6 = load u8 %t5
    %t7 = cmp ne u8 %t6, 7
    %t8 = convert trunc i1 i64 %t7
    branch %t8, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b3:
    return void
  block ^b1:
    jump ^b4
  block ^b4:
    jump ^b4
  block ^b5:
    unreachable
}
function @rg.19(%p0 : ptr) -> ptr {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    return ptr %t0
}
function @rg.18.i2(%p0 : ptr) -> ptr {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    return ptr %t0
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.20()
    return i64 0
}
