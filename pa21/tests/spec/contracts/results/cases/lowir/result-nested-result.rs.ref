function @rg.29() -> void {
  slot $s0 : u8
  slot $s1 : ptr
  slot $s2 : ptr
  block ^b0:
    store u8 7, $s0
    %t0 = addr $s0
    store ptr %t0, $s1
    %t1 = load ptr $s1
    %t2 = call ptr @rg.28.i1(%t1)
    store ptr %t2, $s2
    %t3 = load ptr $s2
    %t4 = load u8 %t3
    %t5 = cmp ne u8 %t4, 7
    %t6 = convert trunc i1 i64 %t5
    branch %t6, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b3:
    return void
  block ^b1:
    jump ^b4
  block ^b4:
    jump ^b4
  block ^b5:
    unreachable
}
function @rg.28.i1(%p0 : ptr) -> ptr {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    return ptr %t0
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.29()
    return i64 0
}
