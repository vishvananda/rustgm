function @rg.24() -> void {
  slot $s0 : u8
  slot $s1 : ptr
  block ^b0:
    store u8 7, $s0
    %t0 = addr $s0
    %t1 = call ptr @rg.23.i1(%t0)
    store ptr %t1, $s1
    %t2 = load ptr $s1
    %t3 = load u8 %t2
    %t4 = cmp ne u8 %t3, 7
    %t5 = convert trunc i1 i64 %t4
    branch %t5, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b3:
    return void
  block ^b1:
    jump ^b4
  block ^b4:
    jump ^b4
  block ^b5:
    unreachable
}
function @rg.23.i1(%p0 : ptr) -> ptr {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    return ptr %t0
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.24()
    return i64 0
}
