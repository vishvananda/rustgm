    %t13 = convert zext i16 u8 %t11
    %t14 = binary add i16 %t12, %t13
    %t15 = convert trunc u8 i16 %t14
    %t16 = convert zext i16 u8 %t15
    %t17 = cmp ne i16 %t14, %t16
    branch %t17, ^b1, ^b3
  block ^b3:
    return u8 %t15
  block ^b1:
