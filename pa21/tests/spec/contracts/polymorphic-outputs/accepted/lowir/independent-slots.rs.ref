    %t9 = cmp ult u8 %t8, %t4
    branch %t9, ^b1, ^b3
  block ^b3:
    return u8 %t8
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
