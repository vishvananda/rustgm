    %t9 = addr $s6
    %t10 = index u8 %t9, 8
    store i64 2, %t10
    %t11 = addr $s6
    %t12 = addr $s2
    copyobj 16x8 %t11, %t12
    %t13 = load ptr $s2
    %t14 = addr $s2
    %t15 = index u8 %t14, 8
    %t16 = load i64 %t15
    %t17 = index u8 %t13, 1
    %t18 = cmp uge i64 0, %t16
    branch %t18, ^b4, ^b5
  block ^b5:
    %t19 = binary mul i64 0, 1
    %t20 = index u8 %t17, %t19
    store u8 8, %t20
    %t21 = load ptr $s1
    %t22 = index u8 %t21, 1
    %t23 = cmp uge i64 1, 2
    branch %t23, ^b4, ^b6
  block ^b6:
    %t24 = binary mul i64 1, 1
    %t25 = index u8 %t22, %t24
    store u8 9, %t25
    %t26 = addr $s0
    %t27 = index u8 %t26, 1
    %t28 = cmp uge i64 0, 2
    branch %t28, ^b4, ^b7
  block ^b7:
    %t29 = binary mul i64 0, 1
    %t30 = index u8 %t27, %t29
    %t31 = load u8 %t30
    %t32 = cmp eq u8 %t31, 8
    %t33 = convert trunc i1 i64 %t32
    branch %t33, ^b1, ^b2
  block ^b2:
    store i1 %t33, $s3
