function @rg.16() -> void {
  slot $s0 : obj<3x1>
  slot $s1 : ptr
  slot $s2 : obj<16x8>
  slot $s3 : i1
  slot $s4 : obj<2x1>
  slot $s5 : obj<3x1>
  slot $s6 : obj<16x8>
  block ^b0:
    store u8 3, $s4
    %t0 = addr $s4
    %t1 = index u8 %t0, 1
    store u8 5, %t1
    store u8 7, $s5
    %t2 = addr $s5
    %t3 = index u8 %t2, 1
    %t4 = addr $s4
    copyobj 2x1 %t4, %t3
    %t5 = addr $s5
    %t6 = addr $s0
    copyobj 3x1 %t5, %t6
    %t7 = addr $s0
    store ptr %t7, $s1
    %t8 = load ptr $s1
