  block ^b1:
    %t34 = addr $s0
    %t35 = index u8 %t34, 1
    %t36 = cmp uge i64 1, 2
    branch %t36, ^b4, ^b8
  block ^b8:
    %t37 = binary mul i64 1, 1
    %t38 = index u8 %t35, %t37
    %t39 = load u8 %t38
    %t40 = cmp eq u8 %t39, 9
    %t41 = convert trunc i1 i64 %t40
    store i1 %t41, $s3
    jump ^b3
  block ^b3:
    %t42 = load i1 $s3
    call void @rg.13(%t42)
    return void
  block ^b4:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
