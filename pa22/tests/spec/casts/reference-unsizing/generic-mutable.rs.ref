function @rg.16() -> void {
  slot $s0 : obj<2x1>
  slot $s1 : obj<16x8>
  slot $s2 : obj<2x1>
  slot $s3 : ptr
  slot $s4 : obj<16x8>
  block ^b0:
    store u8 3, $s2
    %t0 = addr $s2
    %t1 = index u8 %t0, 1
    store u8 5, %t1
    %t2 = addr $s2
    %t3 = addr $s0
    copyobj 2x1 %t2, %t3
    %t4 = addr $s0
    store ptr %t4, $s3
    %t5 = load ptr $s3
    %t6 = addr $s4
    call void @rg.15.i3(%t6, %t5)
    %t7 = addr $s4
    %t8 = addr $s1
    copyobj 16x8 %t7, %t8
    %t9 = load ptr $s1
    %t10 = addr $s1
    %t11 = index u8 %t10, 8
    %t12 = load i64 %t11
    %t13 = cmp uge i64 0, %t12
    branch %t13, ^b1, ^b2
  block ^b2:
    %t14 = binary mul i64 0, 1
    %t15 = index u8 %t9, %t14
    store u8 8, %t15
    %t16 = cmp uge i64 0, 2
    branch %t16, ^b1, ^b3
  block ^b3:
    %t17 = binary mul i64 0, 1
    %t18 = addr $s0
    %t19 = index u8 %t18, %t17
    %t20 = load u8 %t19
    %t21 = cmp eq u8 %t20, 8
    %t22 = convert trunc i1 i64 %t21
    call void @rg.13(%t22)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.15.i3(%p0 : ptr, %p1 : ptr) -> void {
  slot $s0 : ptr
  slot $s1 : obj<16x8>
  slot $s2 : obj<16x8>
  block ^b0:
    store ptr %p1, $s0
    %t0 = load ptr $s0
    store ptr %t0, $s1
    %t1 = addr $s1
    %t2 = index u8 %t1, 8
    store i64 2, %t2
    %t3 = load ptr $s1
    %t4 = addr $s1
    %t5 = index u8 %t4, 8
    %t6 = load i64 %t5
    store ptr %t3, $s2
    %t7 = addr $s2
    %t8 = index u8 %t7, 8
    store i64 %t6, %t8
    %t9 = addr $s2
    copyobj 16x8 %t9, %p0
    return void
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
