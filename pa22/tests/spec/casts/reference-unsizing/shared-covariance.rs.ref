function @rg.16() -> void {
  slot $s0 : u8
  slot $s1 : obj<8x8>
  slot $s2 : obj<8x8>
  slot $s3 : obj<16x8>
  block ^b0:
    store u8 7, $s0
    %t0 = addr $s0
    store ptr %t0, $s2
    %t1 = addr $s2
    %t2 = addr $s1
    copyobj 8x8 %t1, %t2
    %t3 = addr $s1
    %t4 = addr $s3
    call void @rg.15(%t4, %t3)
    %t5 = load ptr $s3
    %t6 = addr $s3
    %t7 = index u8 %t6, 8
    %t8 = load i64 %t7
    %t9 = cmp uge i64 0, %t8
    branch %t9, ^b1, ^b2
  block ^b2:
    %t10 = binary mul i64 0, 8
    %t11 = index u8 %t5, %t10
    %t12 = load ptr %t11
    %t13 = load u8 %t12
    %t14 = cmp eq u8 %t13, 7
    %t15 = convert trunc i1 i64 %t14
    call void @rg.13(%t15)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.15(%p0 : ptr, %p1 : ptr) -> void {
  slot $s0 : ptr
  slot $s1 : obj<16x8>
  block ^b0:
    store ptr %p1, $s0
    %t0 = load ptr $s0
    store ptr %t0, $s1
    %t1 = addr $s1
    %t2 = index u8 %t1, 8
    store i64 1, %t2
    %t3 = addr $s1
    copyobj 16x8 %t3, %p0
    return void
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
