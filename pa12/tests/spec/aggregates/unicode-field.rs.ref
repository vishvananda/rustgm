function @rg.14(%p0 : i32) -> i32 {
  slot $s0 : i32
  block ^b0:
    store i32 %p0, $s0
    %t0 = load i32 $s0
    %t1 = cmp eq i32 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = cmp eq i32 1, 2147483648
    %t3 = cmp eq i32 %t0, 4294967295
    %t4 = binary and i64 %t2, %t3
    branch %t4, ^b1, ^b3
  block ^b3:
    %t5 = binary div i32 1, %t0
    return i32 %t5
  block ^b1:
