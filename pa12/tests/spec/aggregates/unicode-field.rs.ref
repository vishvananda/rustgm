function @rg.16() -> void {
  slot $s0 : obj<16x8>
  slot $s1 : i1
  slot $s2 : obj<16x8>
  block ^b0:
    store u8 7, $s2
    %t0 = addr $s2
    %t1 = index u8 %t0, 8
    store i64 99, %t1
    %t2 = addr $s2
    %t3 = addr $s0
    copyobj 16x8 %t2, %t3
    %t4 = load u8 $s0
    %t5 = cmp eq u8 %t4, 7
    %t6 = convert trunc i1 i64 %t5
    branch %t6, ^b1, ^b2
  block ^b2:
    store i1 %t6, $s1
    jump ^b3
  block ^b1:
    %t7 = addr $s0
    %t8 = index u8 %t7, 8
    %t9 = load i64 %t8
    %t10 = cmp eq i64 %t9, 99
    %t11 = convert trunc i1 i64 %t10
    store i1 %t11, $s1
    jump ^b3
  block ^b3:
    %t12 = load i1 $s1
    call void @rg.13(%t12)
    return void
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call i32 @rg.14(0)
