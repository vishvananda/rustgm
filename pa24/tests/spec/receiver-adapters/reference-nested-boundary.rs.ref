    %t2 = addr $s1
    copyobj 8x8 %t1, %t2
    %t3 = addr $s1
    store ptr %t3, $s2
    %t4 = addr $s2
    %t5 = call u8 @rg.15.i4(%t4)
    %t6 = cmp eq u8 %t5, 7
    %t7 = convert trunc i1 i64 %t6
    call void @rg.13(%t7)
    return void
