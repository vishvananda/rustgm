function @rg.16() -> void {
  slot $s0 : u8
  slot $s1 : ptr
  block ^b0:
    store u8 7, $s0
    %t0 = addr $s0
    store ptr %t0, $s1
    %t1 = load ptr $s1
    call void @rg.15.i3(%t1, 9)
    %t2 = load u8 $s0
    %t3 = cmp eq u8 %t2, 9
    %t4 = convert trunc i1 i64 %t3
    call void @rg.13(%t4)
    return void
}
function @rg.15.i3(%p0 : ptr, %p1 : u8) -> void {
  slot $s0 : ptr
  slot $s1 : u8
  slot $s2 : obj<16x8>
  slot $s3 : obj<16x8>
  block ^b0:
    store ptr %p0, $s0
    store u8 %p1, $s1
    %t0 = load ptr $s0
    %t1 = addr $s1
    store ptr %t0, $s3
    %t2 = addr $s3
    %t3 = index u8 %t2, 8
    store ptr %t1, %t3
    %t4 = addr $s3
    %t5 = addr $s2
    copyobj 16x8 %t4, %t5
    %t6 = addr $s2
    call void @rg.closure.0.i4(%t6)
    return void
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
function @rg.closure.0.i4(%p0 : ptr) -> void {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    %t1 = load ptr %t0
    %t2 = index u8 %t0, 8
    %t3 = load ptr %t2
    %t4 = load u8 %t3
    store u8 %t4, %t1
    return void
}
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
