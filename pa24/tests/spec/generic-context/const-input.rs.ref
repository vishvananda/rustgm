  block ^b2:
    %t12 = binary mul i64 0, 1
    %t13 = index u8 %t10, %t12
    %t14 = load u8 %t13
    %t15 = cmp eq u8 %t14, 7
    %t16 = convert trunc i1 i64 %t15
    call void @rg.13(%t16)
