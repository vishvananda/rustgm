    copyobj 2x1 %t5, %t6
    %t7 = addr $s0
    %t8 = addr $s1
    %t9 = call ptr @rg.closure.0(%t8)
    store ptr %t9, $s4
    %t10 = load ptr $s4
    %t11 = cmp uge i64 0, 2
