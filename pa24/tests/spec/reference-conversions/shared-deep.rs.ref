function @rg.16() -> void {
  slot $s0 : u8
  slot $s1 : ptr
  slot $s2 : ptr
  slot $s3 : obj<8x8>
  slot $s4 : obj<8x8>
  block ^b0:
    store u8 7, $s0
    %t0 = addr $s0
    store ptr %t0, $s1
    %t1 = addr $s1
    store ptr %t1, $s2
    %t2 = load ptr $s2
    %t3 = load ptr %t2
    store ptr %t3, $s4
    %t4 = addr $s4
    %t5 = addr $s3
    copyobj 8x8 %t4, %t5
    %t6 = addr $s3
    %t7 = call u8 @rg.closure.0(%t6)
    %t8 = cmp eq u8 %t7, 7
    %t9 = convert trunc i1 i64 %t8
    call void @rg.13(%t9)
    return void
}
function @rg.closure.0(%p0 : ptr) -> u8 {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    %t1 = load ptr %t0
    %t2 = call u8 @rg.15(%t1)
    return u8 %t2
