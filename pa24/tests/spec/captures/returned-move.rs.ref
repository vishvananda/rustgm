function @rg.16() -> void {
  slot $s0 : obj<1x1>
  slot $s1 : obj<1x1>
  block ^b0:
    %t0 = addr $s1
    call void @rg.15.i3(%t0, 7)
    %t1 = addr $s1
    %t2 = addr $s0
    copyobj 1x1 %t1, %t2
    %t3 = addr $s0
    %t4 = call u8 @rg.closure.0.i4(%t3, 2)
    %t5 = cmp eq u8 %t4, 9
    %t6 = convert trunc i1 i64 %t5
    call void @rg.13(%t6)
    return void
}
function @rg.15.i3(%p0 : ptr, %p1 : u8) -> void {
  slot $s0 : u8
  slot $s1 : obj<1x1>
  block ^b0:
    store u8 %p1, $s0
    %t0 = load u8 $s0
    store u8 %t0, $s1
    %t1 = addr $s1
    copyobj 1x1 %t1, %p0
    return void
}
function @rg.closure.0.i4(%p0 : ptr, %p1 : u8) -> u8 {
  slot $s0 : ptr
  slot $s1 : u8
  block ^b0:
    store ptr %p0, $s0
    store u8 %p1, $s1
    %t0 = load ptr $s0
    %t1 = load u8 $s1
    %t2 = load u8 %t0
    %t3 = binary add u8 %t1, %t2
    %t4 = cmp ult u8 %t3, %t1
    branch %t4, ^b1, ^b2
  block ^b2:
    return u8 %t3
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
