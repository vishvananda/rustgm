function @rg.15() -> void {
  slot $s0 : u8
  slot $s1 : obj<8x8>
  slot $s2 : obj<8x8>
  block ^b0:
    store u8 7, $s0
    %t0 = addr $s0
    store ptr %t0, $s2
    %t1 = addr $s2
    %t2 = addr $s1
    copyobj 8x8 %t1, %t2
    %t3 = addr $s1
    %t4 = call u8 @rg.closure.0(%t3)
    %t5 = cmp eq u8 %t4, 9
    %t6 = convert trunc i1 i64 %t5
    call void @rg.13(%t6)
    %t7 = addr $s1
    %t8 = call u8 @rg.closure.0(%t7)
    %t9 = cmp eq u8 %t8, 11
    %t10 = convert trunc i1 i64 %t9
    call void @rg.13(%t10)
    %t11 = load u8 $s0
    %t12 = cmp eq u8 %t11, 11
    %t13 = convert trunc i1 i64 %t12
    call void @rg.13(%t13)
    return void
}
function @rg.closure.0(%p0 : ptr) -> u8 {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    %t1 = load ptr %t0
    %t2 = load u8 %t1
    %t3 = convert zext i16 u8 %t2
    %t4 = convert zext i16 u8 2
    %t5 = binary add i16 %t3, %t4
    %t6 = convert trunc u8 i16 %t5
    %t7 = convert zext i16 u8 %t6
    %t8 = cmp ne i16 %t5, %t7
    branch %t8, ^b1, ^b2
  block ^b2:
    store u8 %t6, %t1
    %t9 = load u8 %t1
    return u8 %t9
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
