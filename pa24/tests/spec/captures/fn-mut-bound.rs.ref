function @rg.16() -> void {
  slot $s0 : u8
  slot $s1 : obj<8x8>
  block ^b0:
    store u8 7, $s0
    %t0 = addr $s0
    store ptr %t0, $s1
    %t1 = addr $s1
    %t2 = call u8 @rg.15.i4(%t1)
    %t3 = cmp eq u8 %t2, 21
    %t4 = convert trunc i1 i64 %t3
    call void @rg.13(%t4)
    %t5 = load u8 $s0
    %t6 = cmp eq u8 %t5, 12
    %t7 = convert trunc i1 i64 %t6
    call void @rg.13(%t7)
    return void
}
function @rg.15.i4(%p0 : ptr) -> u8 {
  slot $s0 : obj<8x8>
  block ^b0:
    %t0 = addr $s0
    copyobj 8x8 %p0, %t0
    %t1 = addr $s0
    %t2 = call u8 @rg.closure.0(%t1, 2)
    %t3 = addr $s0
    %t4 = call u8 @rg.closure.0(%t3, 3)
    %t5 = binary add u8 %t2, %t4
    %t6 = cmp ult u8 %t5, %t2
    branch %t6, ^b1, ^b2
  block ^b2:
    return u8 %t5
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
function @rg.closure.0(%p0 : ptr, %p1 : u8) -> u8 {
  slot $s0 : ptr
  slot $s1 : u8
  block ^b0:
    store ptr %p0, $s0
    store u8 %p1, $s1
    %t0 = load ptr $s0
    %t1 = load ptr %t0
    %t2 = load u8 $s1
    %t3 = load u8 %t1
    %t4 = binary add u8 %t3, %t2
    %t5 = cmp ult u8 %t4, %t3
    branch %t5, ^b1, ^b2
  block ^b2:
    store u8 %t4, %t1
    %t6 = load u8 %t1
    return u8 %t6
  block ^b1:
    call void @abort()
    unreachable
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
