function @rg.16() -> void {
  slot $s0 : u8
  slot $s1 : obj<1x1>
  block ^b0:
    store u8 7, $s0
    %t0 = load u8 $s0
    store u8 %t0, $s1
    %t1 = addr $s1
    %t2 = call u8 @rg.15.i4(%t1)
    %t3 = cmp eq u8 %t2, 14
    %t4 = convert trunc i1 i64 %t3
    call void @rg.13(%t4)
    return void
}
function @rg.15.i4(%p0 : ptr) -> u8 {
  slot $s0 : obj<1x1>
  block ^b0:
    %t0 = addr $s0
    copyobj 1x1 %p0, %t0
    %t1 = addr $s0
    %t2 = call u8 @rg.closure.0(%t1)
    %t3 = addr $s0
    %t4 = call u8 @rg.closure.0(%t3)
    %t5 = convert zext i16 u8 %t2
    %t6 = convert zext i16 u8 %t4
    %t7 = binary add i16 %t5, %t6
    %t8 = convert trunc u8 i16 %t7
    %t9 = convert zext i16 u8 %t8
    %t10 = cmp ne i16 %t7, %t9
    branch %t10, ^b1, ^b2
  block ^b2:
    return u8 %t8
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
function @rg.closure.0(%p0 : ptr) -> u8 {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    %t1 = load u8 %t0
    return u8 %t1
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
