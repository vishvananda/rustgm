function @rg.16() -> void {
  slot $s0 : u32
  slot $s1 : ptr
  slot $s2 : ptr
  block ^b0:
    %t0 = cmp eq u32 37, 37
    %t1 = convert trunc i1 i64 %t0
    call void @rg.13(%t1)
    store u32 7, $s0
    %t2 = addr $s0
    store ptr %t2, $s1
    %t3 = addr $s1
    %t4 = call ptr @rg.intrinsic.read.t70(%t3)
    store ptr %t4, $s2
    %t5 = load ptr $s2
    store u32 37, %t5
    %t6 = addr $s1
    %t7 = load ptr $s2
    call void @rg.intrinsic.write.t73(%t6, %t7)
    %t8 = load ptr $s1
    %t9 = load u32 %t8
    %t10 = cmp eq u32 %t9, 37
    %t11 = convert trunc i1 i64 %t10
    call void @rg.13(%t11)
    return void
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
function @rg.intrinsic.read.t70(%p0 : ptr) -> ptr {
  block ^b0:
    %t0 = load ptr %p0
    return ptr %t0
}
function @rg.intrinsic.write.t73(%p0 : ptr, %p1 : ptr) -> void {
  block ^b0:
    store ptr %p1, %p0
    return void
}
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
  block ^b0:
