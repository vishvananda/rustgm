function @rg.13() -> void {
  slot $s0 : u32
  slot $s1 : u32
  block ^b0:
    store u32 7, $s0
    %t0 = addr $s0
    %t1 = call u32 @rg.intrinsic.read.t63(%t0)
    store u32 %t1, $s1
    %t2 = addr $s0
    %t3 = load u32 $s1
    %t4 = binary add u32 %t3, 30
    %t5 = cmp ult u32 %t4, %t3
    branch %t5, ^b1, ^b2
  block ^b2:
    call void @rg.intrinsic.write.t66(%t2, %t4)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.intrinsic.read.t63(%p0 : ptr) -> u32 {
  block ^b0:
    %t0 = load u32 %p0
    return u32 %t0
}
function @rg.intrinsic.write.t66(%p0 : ptr, %p1 : u32) -> void {
  block ^b0:
    store u32 %p1, %p0
    return void
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
  block ^b0:
