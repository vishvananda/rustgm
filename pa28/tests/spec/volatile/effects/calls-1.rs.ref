function @rg.14() -> void {
  slot $s0 : u32
  slot $s1 : ptr
  block ^b0:
    store u32 7, $s0
    %t0 = addr $s0
    %t1 = load volatile u32 %t0
    %t2 = addr $s0
    store volatile u32 9, %t2
    %t3 = addr @rg.intrinsic.read_volatile.t63
    store ptr %t3, $s1
    %t4 = load ptr $s1
    %t5 = addr $s0
    %t6 = call u32 %t4(%t5) as (%p0 : ptr) -> u32
    return void
}
function @rg.intrinsic.read_volatile.t63(%p0 : ptr) -> u32 {
  block ^b0:
    %t0 = load volatile u32 %p0
    return u32 %t0
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.14()
    return i64 0
}
