global @rg.data.0 : obj<4x4> = {
  zero 4
}
function @rg.54() -> void {
  slot $s0 : ptr
  slot $s1 : ptr
  slot $s2 : obj<1x1>
  block ^b0:
    %t0 = addr @rg.intrinsic.load.t34
    store ptr %t0, $s0
    %t1 = load ptr $s0
    %t2 = addr @rg.data.0
    store ptr %t2, $s1
    %t3 = load ptr $s1
    store u8 1, $s2
    %t4 = load u8 $s2
    %t5 = call u32 %t1(%t3, %t4) as (%p0 : ptr, %p1 : u8) -> u32
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.intrinsic.load.t34(%p0 : ptr, %p1 : u8) -> u32 {
  block ^b0:
    %t0 = cmp eq u8 %p1, 0
    branch %t0, ^b2, ^b3
  block ^b2:
    %t1 = atomic_load u32 %p0, 0
    return u32 %t1
  block ^b3:
    %t2 = cmp eq u8 %p1, 2
    branch %t2, ^b4, ^b5
  block ^b4:
    %t3 = atomic_load u32 %p0, 2
    return u32 %t3
  block ^b5:
    %t4 = cmp eq u8 %p1, 4
    branch %t4, ^b6, ^b7
  block ^b6:
    %t5 = atomic_load u32 %p0, 5
    return u32 %t5
  block ^b7:
    jump ^b1
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.54()
    return i64 0
