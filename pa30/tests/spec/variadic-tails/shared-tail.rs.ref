function @rg.16() -> void {
  slot $s0 : i64
  block ^b0:
    store i64 7, $s0
    %t0 = addr $s0
    %t1 = addr $s0
    %t2 = call u32 @ignores_tail(3, %t0, %t1)
    %t3 = cmp eq u32 %t2, 3
    %t4 = convert trunc i1 i64 %t3
    call void @rg.14(%t4)
    return void
}
declare function @ignores_tail(%p0 : u32) -> u32 [arity=variadic]
function @rg.14(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.15(0)
    jump ^b3
  block ^b3:
    return void
}
function @rg.15(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
