function @rg.17() -> void {
  slot $s0 : obj<16x8>
  slot $s1 : obj<16x8>
  block ^b0:
    store i64 7, $s0
    %t0 = addr $s0
    %t1 = index u8 %t0, 8
    store f64 1.50000000000000000e0, %t1
    %t2 = unary neg i32 9
    store i64 11, $s1
    %t3 = addr $s1
    %t4 = index u8 %t3, 8
    store f64 2.50000000000000000e0, %t4
    %t5 = call u32 @pairs(3, $s0, %t2, $s1) [classes=1:integer_sse, classes=3:integer_sse]
    %t6 = cmp eq u32 %t5, 1
    %t7 = convert trunc i1 i64 %t6
    call void @rg.15(%t7)
    return void
}
declare function @pairs(%p0 : u32) -> u32 [arity=variadic]
function @rg.15(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.16(0)
