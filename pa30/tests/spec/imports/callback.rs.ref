function @rg.17() -> void {
  block ^b0:
    %t0 = addr @rg.14
    %t1 = call i32 @invoke_callback(%t0, 20)
    %t2 = cmp eq i32 %t1, 42
    %t3 = convert trunc i1 i64 %t2
    call void @rg.15(%t3)
