    %t2 = convert sext i64 i32 2
    %t3 = binary mul i64 %t1, %t2
    %t4 = convert trunc i32 i64 %t3
    %t5 = convert sext i64 i32 %t4
    %t6 = cmp ne i64 %t3, %t5
    branch %t6, ^b1, ^b2
  block ^b2:
    return i32 %t4
  block ^b1:
    call void @abort()
