function @rg.16() -> void {
  block ^b0:
    %t0 = copy i64 1
    %t1 = copy i64 2
    %t2 = copy i64 3
    %t3 = call i64 @sum(3, %t0, %t1, %t2)
    %t4 = cmp eq i64 %t3, 6
    %t5 = convert trunc i1 i64 %t4
    call void @rg.14(%t5)
    return void
}
declare function @sum(%p0 : u32) -> i64 [arity=variadic]
function @rg.14(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.15(0)
    jump ^b3
  block ^b3:
    return void
}
function @rg.15(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
