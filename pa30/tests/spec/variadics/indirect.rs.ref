function @rg.17() -> void {
  block ^b0:
    %t0 = addr @sum
    %t1 = call i64 @rg.16(%t0)
    %t2 = cmp eq i64 %t1, 24
    %t3 = convert trunc i1 i64 %t2
    call void @rg.14(%t3)
    return void
}
declare function @sum(%p0 : u32) -> i64 [arity=variadic]
function @rg.16(%p0 : ptr) -> i64 {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    %t1 = copy i64 11
    %t2 = copy i64 13
    %t3 = call i64 %t0(2, %t1, %t2) as (%p0 : u32) -> i64 [arity=variadic]
    return i64 %t3
}
function @rg.14(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.15(0)
    jump ^b3
  block ^b3:
    return void
}
function @rg.15(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.17()
    return i64 0
}
