    %t4 = load ptr $s2
    %t5 = call i64 @rg.16(%t4)
    %t6 = addr $s0
    store ptr %t6, $s3
    %t7 = load ptr $s3
    %t8 = call i64 @rg.16(%t7)
    %t9 = call i64 @sum(3, %t2, %t5, %t8)
    %t10 = cmp eq i64 %t9, 6
    %t11 = convert trunc i1 i64 %t10
    call void @rg.14(%t11)
    %t12 = load i64 $s0
    %t13 = cmp eq i64 %t12, 3
    %t14 = convert trunc i1 i64 %t13
    call void @rg.14(%t14)
    return void
}
function @rg.16(%p0 : ptr) -> i64 {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    %t0 = load ptr $s0
    %t1 = load i64 %t0
    %t2 = binary add i64 %t1, 1
    %t3 = binary xor i64 %t1, %t2
    %t4 = binary xor i64 %t2, 1
    %t5 = binary and i64 %t3, %t4
    %t6 = cmp lt i64 %t5, 0
    branch %t6, ^b1, ^b2
  block ^b2:
    store i64 %t2, %t0
    %t7 = load ptr $s0
    %t8 = load i64 %t7
    return i64 %t8
  block ^b1:
    call void @abort()
    unreachable
}
declare function @sum(%p0 : u32) -> i64 [arity=variadic]
function @rg.14(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
