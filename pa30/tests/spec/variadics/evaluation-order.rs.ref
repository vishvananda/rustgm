function @rg.17() -> void {
  slot $s0 : i64
  slot $s1 : ptr
  slot $s2 : ptr
  slot $s3 : ptr
  block ^b0:
    store i64 0, $s0
    %t0 = addr $s0
    store ptr %t0, $s1
    %t1 = load ptr $s1
    %t2 = call i64 @rg.16(%t1)
    %t3 = addr $s0
