function @rg.16() -> void {
  slot $s0 : obj<4x2>
  slot $s1 : obj<4x2>
  block ^b0:
    store u16 300, $s1
    %t0 = addr $s1
    %t1 = index u8 %t0, 2
    store u16 500, %t1
    %t2 = addr $s1
    %t3 = addr $s0
    copyobj 4x2 %t2, %t3
    %t4 = load u16 $s0
    %t5 = addr $s0
    %t6 = index u8 %t5, 2
    %t7 = load u16 %t6
    %t8 = binary add u16 %t4, %t7
    %t9 = cmp ult u16 %t8, %t4
    branch %t9, ^b1, ^b2
  block ^b2:
    %t10 = cmp eq u16 %t8, 800
    %t11 = convert trunc i1 i64 %t10
    call void @rg.13(%t11)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
