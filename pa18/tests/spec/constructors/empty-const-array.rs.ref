    %t1 = addr $s1
    call void @rg.16.i4(%t0, %t1)
    %t2 = addr $s2
    %t3 = addr $s0
    copyobj 1x1 %t2, %t3
    %t4 = cmp uge i64 0, 1
    branch %t4, ^b1, ^b2
  block ^b2:
    %t5 = binary mul i64 0, 1
    %t6 = addr $s0
    %t7 = index u8 %t6, %t5
    %t8 = load u8 %t7
    %t9 = cmp eq u8 %t8, 21
    %t10 = convert trunc i1 i64 %t9
    call void @rg.13(%t10)
    return void
  block ^b1:
    call void @abort()
