function @rg.15() -> void {
  slot $s0 : obj<1x1>
  slot $s1 : obj<1x1>
  block ^b0:
    %t0 = addr $s1
    call void @rg.14.i1(%t0, 1)
    %t1 = addr $s1
    %t2 = addr $s0
    copyobj 1x1 %t1, %t2
    return void
}
function @rg.14.i1(%p0 : ptr, %p1 : u8) -> void {
  slot $s0 : u8
  slot $s1 : obj<1x1>
  block ^b0:
    store u8 %p1, $s0
    %t0 = load u8 $s0
    store u8 %t0, $s1
    %t1 = addr $s1
    copyobj 1x1 %t1, %p0
    return void
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.15()
    return i64 0
}
