function @rg.17() -> void {
  slot $s0 : obj<2x1>
  block ^b0:
    store u8 3, $s0
    %t0 = addr $s0
    %t1 = index u8 %t0, 1
    store u8 4, %t1
    %t2 = addr $s0
    %t3 = call u8 @rg.16(%t2, 2)
    return void
}
function @rg.16(%p0 : ptr, %p1 : i64) -> u8 {
  slot $s0 : obj<2x1>
  slot $s1 : i64
  block ^b0:
    %t0 = addr $s0
    copyobj 2x1 %p0, %t0
    store i64 %p1, $s1
    %t1 = load i64 $s1
    %t2 = cmp uge i64 %t1, 2
    branch %t2, ^b1, ^b2
  block ^b2:
    %t3 = binary mul i64 %t1, 1
    %t4 = addr $s0
    %t5 = index u8 %t4, %t3
    %t6 = load u8 %t5
    return u8 %t6
  block ^b1:
    call void @abort()
    unreachable
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.17()
    return i64 0
