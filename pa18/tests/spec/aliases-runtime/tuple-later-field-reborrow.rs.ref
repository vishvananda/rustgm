    %t2 = addr $s3
    %t3 = index u8 %t2, 8
    store ptr %t1, %t3
    %t4 = addr $s3
    %t5 = addr $s2
    copyobj 16x8 %t4, %t5
    %t6 = load ptr $s2
    store u8 17, %t6
    %t7 = addr $s2
    %t8 = index u8 %t7, 8
    %t9 = load ptr %t8
    store u8 19, %t9
    %t10 = load ptr $s1
    store u8 73, %t10
    return void
