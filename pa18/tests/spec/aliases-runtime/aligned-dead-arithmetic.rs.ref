function @rg.22() -> void {
  slot $s0 : obj<1x1>
  slot $s1 : obj<1x1>
  block ^b0:
    store u8 5, $s1
    %t0 = addr $s1
    %t1 = addr $s0
    copyobj 1x1 %t0, %t1
    %t2 = cmp uge i64 0, 1
    branch %t2, ^b1, ^b2
  block ^b2:
    %t3 = binary mul i64 0, 1
    %t4 = addr $s0
    %t5 = index u8 %t4, %t3
    %t6 = load u8 %t5
    %t7 = cmp eq u8 %t6, 5
    %t8 = convert trunc i1 i64 %t7
    call void @rg.13(%t8)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
