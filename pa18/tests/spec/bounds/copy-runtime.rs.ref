function @rg.16() -> void {
  slot $s0 : u16
  slot $s1 : u16
  slot $s2 : obj<4x2>
  block ^b0:
    %t0 = addr $s2
    call void @rg.15.i3(%t0, 300)
    %t1 = load u16 $s2
    store u16 %t1, $s0
    %t2 = addr $s2
    %t3 = index u8 %t2, 2
    %t4 = load u16 %t3
    store u16 %t4, $s1
    %t5 = load u16 $s0
    %t6 = load u16 $s1
    %t7 = binary add u16 %t5, %t6
    %t8 = cmp ult u16 %t7, %t5
    branch %t8, ^b1, ^b2
  block ^b2:
    %t9 = cmp eq u16 %t7, 600
    %t10 = convert trunc i1 i64 %t9
    call void @rg.13(%t10)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.15.i3(%p0 : ptr, %p1 : u16) -> void {
  slot $s0 : u16
  slot $s1 : obj<4x2>
  block ^b0:
    store u16 %p1, $s0
    %t0 = load u16 $s0
    %t1 = load u16 $s0
    store u16 %t0, $s1
    %t2 = addr $s1
    %t3 = index u8 %t2, 2
    store u16 %t1, %t3
    %t4 = addr $s1
    copyobj 4x2 %t4, %p0
    return void
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
