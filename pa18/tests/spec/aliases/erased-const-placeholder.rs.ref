function @rg.17() -> void {
  slot $s0 : u8
  slot $s1 : u8
  block ^b0:
    store u8 7, $s0
    store u8 9, $s1
    %t0 = load u8 $s0
    %t1 = load u8 $s1
    %t2 = binary add u8 %t0, %t1
    %t3 = cmp ult u8 %t2, %t0
    branch %t3, ^b1, ^b2
  block ^b2:
    %t4 = cmp eq u8 %t2, 16
    %t5 = convert trunc i1 i64 %t4
    call void @rg.16(%t5)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.16(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.15(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.15(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.17()
    return i64 0
}
