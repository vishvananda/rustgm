function @rg.17() -> void {
  slot $s0 : u8
  slot $s1 : u8
  block ^b0:
    store u8 7, $s0
    store u8 9, $s1
    %t0 = load u8 $s0
    %t1 = load u8 $s1
    %t2 = convert zext i16 u8 %t0
    %t3 = convert zext i16 u8 %t1
    %t4 = binary add i16 %t2, %t3
    %t5 = convert trunc u8 i16 %t4
    %t6 = convert zext i16 u8 %t5
    %t7 = cmp ne i16 %t4, %t6
    branch %t7, ^b1, ^b2
  block ^b2:
    %t8 = cmp eq u8 %t5, 16
    %t9 = convert trunc i1 i64 %t8
    call void @rg.16(%t9)
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.16(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.15(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.15(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.17()
    return i64 0
}
