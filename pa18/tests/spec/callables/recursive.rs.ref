function @rg.16() -> void {
  block ^b0:
    %t0 = call u8 @rg.15.i3(7, 4)
    %t1 = cmp eq u8 %t0, 7
    %t2 = convert trunc i1 i64 %t1
    call void @rg.13(%t2)
    return void
}
function @rg.15.i3(%p0 : u8, %p1 : u8) -> u8 {
  slot $s0 : u8
  slot $s1 : u8
  slot $s2 : u8
  block ^b0:
    store u8 %p0, $s0
    store u8 %p1, $s1
    %t0 = load u8 $s1
    %t1 = cmp eq u8 %t0, 0
    %t2 = convert trunc i1 i64 %t1
    branch %t2, ^b1, ^b2
  block ^b2:
    %t3 = load u8 $s0
    %t4 = load u8 $s1
    %t5 = binary sub u8 %t4, 1
    %t6 = cmp ult u8 %t4, 1
    branch %t6, ^b4, ^b5
  block ^b5:
    %t7 = call u8 @rg.15.i3(%t3, %t5)
    store u8 %t7, $s2
    jump ^b3
  block ^b1:
    %t8 = load u8 $s0
    store u8 %t8, $s2
    jump ^b3
  block ^b3:
    %t9 = load u8 $s2
    return u8 %t9
  block ^b4:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
