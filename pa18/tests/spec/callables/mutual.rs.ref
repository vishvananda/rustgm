    %t7 = binary sub i16 %t5, %t6
    %t8 = convert trunc u8 i16 %t7
    %t9 = convert zext i16 u8 %t8
    %t10 = cmp ne i16 %t7, %t9
    branch %t10, ^b4, ^b5
  block ^b5:
    %t11 = call u16 @rg.16.i4(%t3, %t8)
    store u16 %t11, $s2
    jump ^b3
  block ^b1:
    %t12 = load u16 $s0
    store u16 %t12, $s2
    jump ^b3
  block ^b3:
    %t13 = load u16 $s2
    return u16 %t13
  block ^b4:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
function @rg.16.i4(%p0 : u16, %p1 : u8) -> u16 {
  slot $s0 : u16
  slot $s1 : u8
  block ^b0:
    store u16 %p0, $s0
    store u8 %p1, $s1
    %t0 = load u16 $s0
    %t1 = load u8 $s1
    %t2 = call u16 @rg.15.i3(%t0, %t1)
    return u16 %t2
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
