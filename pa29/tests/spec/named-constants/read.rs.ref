function @entry() -> i32 {
  slot $s0 : i32
  slot $s1 : obj<24x8>
  block ^b0:
    %t0 = copy u8 255
    store i64 4, $s1
    %t1 = addr $s1
    %t2 = index u8 %t1, 8
    store i1 1, %t2
    %t3 = addr $s1
    %t4 = index u8 %t3, 12
    store u32 120, %t4
    %t5 = addr $s1
    %t6 = index u8 %t5, 16
    store u8 %t0, %t6
    %t7 = load i64 $s1
    %t8 = cmp eq i64 %t7, 4
    %t9 = convert trunc i1 i64 %t8
    branch %t9, ^b4, ^b3
  block ^b4:
    %t10 = addr $s1
    %t11 = index u8 %t10, 8
    %t12 = load i1 %t11
    %t13 = cmp eq i1 %t12, 1
    %t14 = convert trunc i1 i64 %t13
    branch %t14, ^b5, ^b3
  block ^b5:
    %t15 = addr $s1
    %t16 = index u8 %t15, 12
    %t17 = load u32 %t16
    %t18 = cmp eq u32 %t17, 120
    %t19 = convert trunc i1 i64 %t18
    branch %t19, ^b6, ^b3
  block ^b6:
    %t20 = addr $s1
    %t21 = index u8 %t20, 16
    %t22 = load u8 %t21
    %t23 = cmp eq u8 %t22, 255
    %t24 = convert trunc i1 i64 %t23
    branch %t24, ^b2, ^b3
  block ^b3:
    jump ^b7
  block ^b7:
    jump ^b8
  block ^b8:
    store i32 1, $s0
    jump ^b1
  block ^b2:
    store i32 42, $s0
    jump ^b1
  block ^b1:
    %t25 = load i32 $s0
    return i32 %t25
  block ^b9:
    unreachable
  block ^b10:
    unreachable
}
