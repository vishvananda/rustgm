function @entry() -> i32 {
  slot $s0 : i32
  block ^b0:
    %t0 = cmp eq i64 4, 4
    %t1 = convert trunc i1 i64 %t0
    branch %t1, ^b2, ^b3
  block ^b3:
    jump ^b4
  block ^b4:
    store i32 1, $s0
    jump ^b1
  block ^b2:
    store i32 42, $s0
    jump ^b1
  block ^b1:
    %t2 = load i32 $s0
    return i32 %t2
  block ^b5:
    unreachable
}
