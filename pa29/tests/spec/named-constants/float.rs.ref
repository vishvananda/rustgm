function @entry() -> i32 {
  slot $s0 : i32
  slot $s1 : u8
  slot $s2 : u8
  slot $s3 : obj<2x1>
  block ^b0:
    %t0 = cmp ne f32 4.25000000000000000e1, 4.25000000000000000e1
    branch %t0, ^b9, ^b10
  block ^b9:
    store u8 0, $s1
