  block ^b10:
    %t1 = cmp ge f32 4.25000000000000000e1, 2.56000000000000000e2
    branch %t1, ^b11, ^b12
  block ^b11:
    store u8 255, $s1
    jump ^b15
  block ^b12:
    %t2 = cmp le f32 4.25000000000000000e1, 0.00000000000000000e0
    branch %t2, ^b13, ^b14
  block ^b13:
    store u8 0, $s1
