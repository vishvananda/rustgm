function @rg.20() -> void {
  slot $s0 : i1
  block ^b0:
    %t0 = cmp ne u8 9, 9
    %t1 = convert trunc i1 i64 %t0
    branch %t1, ^b4, ^b5
  block ^b5:
    %t2 = unary not i1 1
    store i1 %t2, $s0
    jump ^b6
  block ^b4:
    store i1 %t1, $s0
    jump ^b6
  block ^b6:
    %t3 = load i1 $s0
    branch %t3, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t4 = call u8 @rg.19(0)
    jump ^b3
  block ^b3:
    return void
}
function @rg.19(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
