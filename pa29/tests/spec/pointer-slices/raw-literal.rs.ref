function @entry() -> i32 {
  slot $s0 : u8
  slot $s1 : obj<16x8>
  slot $s2 : i32
  slot $s3 : obj<16x8>
  block ^b0:
    store u8 42, $s0
    %t0 = addr $s0
    store ptr %t0, $s3
    %t1 = addr $s3
    %t2 = index u8 %t1, 8
    store u8 1, %t2
    %t3 = addr $s3
    %t4 = addr $s1
    copyobj 16x8 %t3, %t4
    %t5 = load ptr $s1
    %t6 = load u8 %t5
    %t7 = cmp eq u8 %t6, 42
    %t8 = convert trunc i1 i64 %t7
    branch %t8, ^b2, ^b3
  block ^b3:
    jump ^b4
  block ^b4:
    store i32 7, $s2
    jump ^b1
  block ^b2:
    store i32 42, $s2
    jump ^b1
  block ^b1:
    %t9 = load i32 $s2
    return i32 %t9
  block ^b5:
    unreachable
}
