function @rg.20() -> void {
  slot $s0 : obj<1x1>
  slot $s1 : i32
  block ^b0:
    %t0 = addr $s0
    %t1 = call u8 @rg.19(%t0)
    %t2 = cmp ne u8 %t1, 7
    %t3 = convert trunc i1 i64 %t2
    branch %t3, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    store i32 0, $s1
    %t4 = load i32 $s1
    %t5 = cmp eq i32 %t4, 0
    branch %t5, ^b4, ^b5
  block ^b5:
    %t6 = cmp eq i32 1, 2147483648
    %t7 = cmp eq i32 %t4, 4294967295
    %t8 = binary and i64 %t6, %t7
    branch %t8, ^b4, ^b6
  block ^b6:
    %t9 = binary div i32 1, %t4
    jump ^b3
  block ^b3:
    return void
  block ^b4:
    call void @abort()
    unreachable
}
function @rg.19(%p0 : ptr) -> u8 {
  slot $s0 : ptr
  block ^b0:
    store ptr %p0, $s0
    return u8 7
}
declare function @abort() -> void [return=noreturn]
function @main() -> i64 [role=entry] {
