function @rg.14() -> void {
  slot $s0 : obj<2x2>
  slot $s1 : u16
  slot $s2 : obj<2x2>
  block ^b0:
    store u16 7, $s2
    %t0 = addr $s2
    %t1 = addr $s0
    copyobj 2x2 %t0, %t1
    %t2 = load u16 $s0
    store u16 %t2, $s1
    return void
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.14()
    return i64 0
}
