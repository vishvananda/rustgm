function @rg.13() -> void {
  slot $s0 : obj<24x8>
  slot $s1 : obj<24x8>
  block ^b0:
    store i64 0, $s1
    %t0 = addr $s1
    %t1 = addr $s0
    copyobj 24x8 %t0, %t1
    %t2 = load i64 $s0
    %t3 = cmp eq i64 %t2, 1
    branch %t3, ^b4, ^b3
  block ^b3:
    jump ^b5
  block ^b5:
    %t4 = load i64 $s0
    %t5 = cmp eq i64 %t4, 0
    branch %t5, ^b8, ^b7
  block ^b7:
    jump ^b9
  block ^b9:
    unreachable
  block ^b8:
    jump ^b6
  block ^b6:
    jump ^b1
  block ^b4:
    jump ^b2
  block ^b2:
    jump ^b1
  block ^b1:
    return void
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.13()
    return i64 0
}
