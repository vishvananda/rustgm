function @rg.16() -> void {
  slot $s0 : u32
  slot $s1 : u32
  block ^b0:
    store u32 3, $s0
    store u32 4, $s1
    %t0 = addr $s0
    %t1 = addr $s1
    call void @rg.53.i3(%t0, %t1)
    %t2 = load u32 $s0
    %t3 = cmp eq u32 %t2, 7
    %t4 = convert trunc i1 i64 %t3
    call void @rg.13(%t4)
    return void
}
function @rg.53.i3(%p0 : ptr, %p1 : ptr) -> void {
  slot $s0 : ptr
  slot $s1 : ptr
  block ^b0:
    store ptr %p0, $s0
    store ptr %p1, $s1
    %t0 = load ptr $s0
    %t1 = load u32 %t0
    %t2 = load ptr $s1
    %t3 = load u32 %t2
    %t4 = binary add u32 %t1, %t3
    %t5 = cmp ult u32 %t4, %t1
    branch %t5, ^b1, ^b2
  block ^b2:
    store u32 %t4, %t0
    return void
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.16()
    return i64 0
}
