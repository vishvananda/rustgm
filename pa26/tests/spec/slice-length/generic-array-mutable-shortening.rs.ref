    %t20 = addr $s7
    %t21 = call i64 @rg.44.i5(%t20)
    %t22 = cmp eq i64 %t21, 2
    %t23 = convert trunc i1 i64 %t22
    call void @rg.13(%t23)
    %t24 = load ptr $s2
    %t25 = addr $s2
    %t26 = index u8 %t25, 8
    %t27 = load i64 %t26
    %t28 = cmp uge i64 0, %t27
    branch %t28, ^b4, ^b5
  block ^b5:
    %t29 = binary mul i64 0, 8
    %t30 = index u8 %t24, %t29
    %t31 = load ptr %t30
    %t32 = load u8 %t31
    %t33 = cmp eq u8 %t32, 7
    %t34 = convert trunc i1 i64 %t33
    call void @rg.13(%t34)
    return void
  block ^b4:
    call void @abort()
