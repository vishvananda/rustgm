function @rg.15() -> void {
  block ^b0:
    %t0 = call i32 @rg.45.i3(32, 3)
    %t1 = cmp eq i32 %t0, 4
    %t2 = convert trunc i1 i64 %t1
    call void @rg.13(%t2)
    return void
}
function @rg.45.i3(%p0 : i32, %p1 : i128) -> i32 {
  slot $s0 : i32
  slot $s1 : i128
  block ^b0:
    store i32 %p0, $s0
    store i128 %p1, $s1
    %t0 = load i32 $s0
    %t1 = load i128 $s1
    %t2 = cmp uge i128 %t1, 32
    branch %t2, ^b1, ^b2
  block ^b2:
    %t3 = convert trunc i32 i128 %t1
    %t4 = binary shr i32 %t0, %t3
    return i32 %t4
  block ^b1:
    call void @abort()
    unreachable
}
function @rg.13(%p0 : i1) -> void {
  slot $s0 : i1
  block ^b0:
    store i1 %p0, $s0
    %t0 = load i1 $s0
    %t1 = unary not i1 %t0
    branch %t1, ^b1, ^b2
  block ^b2:
    jump ^b3
  block ^b1:
    %t2 = call u8 @rg.14(0)
    jump ^b3
  block ^b3:
    return void
}
declare function @abort() -> void [return=noreturn]
function @rg.14(%p0 : u8) -> u8 {
  slot $s0 : u8
  block ^b0:
    store u8 %p0, $s0
    %t0 = load u8 $s0
    %t1 = cmp eq u8 %t0, 0
    branch %t1, ^b1, ^b2
  block ^b2:
    %t2 = binary udiv u8 1, %t0
    return u8 %t2
  block ^b1:
    call void @abort()
    unreachable
}
function @main() -> i64 [role=entry] {
  block ^b0:
    call void @rg.15()
    return i64 0
}
